# Set these in the service environment; this application does not auto-load env files.
AURA_DATA_DIR=./data
# Generate separate random tokens; no built-in password or permissive default.
AURA_ADMIN_TOKEN=
AURA_VIEWER_TOKEN=
# Research and virtual are the only accepted configuration modes in milestone 1.
AURA_MODE=research
# AI providers and MT5 execution are not wired in milestone 1.

# Optional Windows read-only MT5 collector; never commit real local configuration.
AURA_MT5_TERMINAL_PATH=
AURA_MT5_EXPECTED_LOGIN=
AURA_MT5_EXPECTED_SERVER=
